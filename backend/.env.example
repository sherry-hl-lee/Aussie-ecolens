# Copy to backend/.env for local FastAPI (optional — vars also read from shell).
# Do NOT commit .env with real secrets.

# --- Cognito JWT validation (optional locally; leave empty to use dev-user) ---
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- SNS tag notifications (Member D) ---
# Without SNS_TOPIC_ARN, notifications are logged to stdout (simulated).
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:ecolens-tag-alerts
SNS_NOTIFICATIONS_ENABLED=true

# Local testing only — fall back to dev-user when Cognito token is expired/invalid.
LOCAL_AUTH_RELAXED=true

# AWS credentials for SNS publish/subscribe from local backend:
#   aws configure   OR   set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION
