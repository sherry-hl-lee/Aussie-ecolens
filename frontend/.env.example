# Copy this file to ".env" and fill in the values from your Cognito User Pool.
# These are read at build time by Vite (only VITE_-prefixed vars are exposed).
#
# Where to find each value in the AWS Console:
#   User Pool ID  -> Cognito > User pools > (your pool) > overview
#   Client ID     -> Cognito > User pools > (your pool) > App integration > App client
#   Domain        -> Cognito > User pools > (your pool) > App integration > Domain
#                    (enter the host only, WITHOUT the leading https://)

VITE_COGNITO_USER_POOL_ID=ap-southeast-2_xxxxxxxxx
VITE_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=your-domain.auth.ap-southeast-2.amazoncognito.com

# Default API for prototype UI (local FastAPI backend).
VITE_API_BASE_URL=http://localhost:8001

# Upload mode: "presigned" for AWS API Gateway (S3 direct upload). Use "local" for multipart POST /upload.
VITE_UPLOAD_MODE=presigned

# OAuth callback — must match Cognito "Allowed callback URLs" exactly (character for character).
VITE_COGNITO_REDIRECT_URI=http://localhost:3000/
